{
  "name": "next-enterprise",
  "version": "1.19.8",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "cross-env FORCE_COLOR=1 next dev --port 3030",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx,mdx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx,mdx}\" --fix",
    "prettier": "prettier --check \"**/*.{js,jsx,ts,tsx}\"",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "format": "yarn lint:fix && yarn prettier:fix",
    "analyze": "next experimental-analyze",
    "test": "cross-env FORCE_COLOR=1 jest --passWithNoTests --silent",
    "types:check": "tsc --noEmit",
    "postinstall": "npx patch-package -y",
    "preinstall": "npx only-allow yarn",
    "gen:icons": "node lib/gen-sprite.mjs -s src/assets/icons -o public/sprite.svg"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.0",
    "framer-motion": "^13.2.0",
    "lodash.throttle": "^4.1.1",
    "mini-svg-data-uri": "^1.4.4",
    "next": "16.3.4",
    "next-mdx-remote": "^6.0.0",
    "prismjs": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-fast-marquee": "^1.6.5",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.3.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@commitlint/cli": "^17.6.5",
    "@commitlint/config-conventional": "^17.6.5",
    "@jest/globals": "^29.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^9.0.2",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.0.4",
    "@semantic-release/npm": "^10.0.6",
    "@semantic-release/release-notes-generator": "^11.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@total-typescript/ts-reset": "^0.4.2",
    "@turbo/gen": "^1.10.6",
    "@types/gtag.js": "^0.0.18",
    "@types/jest-axe": "^3.5.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^24.13.3",
    "@types/prismjs": "^1.26.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.14",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^7.0.3",
    "cssnano": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-testing-library": "^7.16.2",
    "fetch-mock": "^9.11.0",
    "husky": "4.3.8",
    "jest": "^29.7.0",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^13.2.2",
    "patch-package": "^8.0.0",
    "postcss": "^8.4.31",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.2.5",
    "semantic-release": "^21.0.7",
    "svg-spreact": "^1.3.2",
    "tailwindcss": "^3.2.7",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mdx}": [
      "yarn format"
    ]
  },
  "husky": {
    "hooks": {
      "commit-msg": "npx commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged",
      "pre-push": "turbo types:check && turbo test && turbo build"
    }
  },
  "packageManager": "yarn@4.2.2",
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      "@semantic-release/commit-analyzer",
      "@semantic-release/git",
      "@semantic-release/changelog"
    ]
  }
}
